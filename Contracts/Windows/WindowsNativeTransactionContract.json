      "owner_group_DACL_SDDL",
      "attributes",
      "creation_time"
    ],
    "backup_required": true,
    "backup_identity_required": true,
    "ambiguous_errors": [
      1175,
      1176,
      1177
    ],
    "ambiguous_error_action": "no_retry_preserve_evidence_require_recovery",
    "successful_backup_cleanup": "verify_sha256_then_delete"
  },
  "configuration_transaction_contract": {
    "plan_lifetime_seconds": 600,
