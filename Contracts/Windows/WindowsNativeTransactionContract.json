    "missing_file": "same_directory_CreateNew_flush_then_atomic_move",
    "no_change": "zero_write",
    "observed_pre_write_drift": "zero_write_prepare_fresh_preview",
    "known_post_write_failure": "preserve_verified_backup_for_Build146_recovery",
    "production_UI_call_site_enabled": false,
